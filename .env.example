# Copy to .env (never commit .env). Defaults run fully offline with no keys.

# Classifier backend: mock (default, local) or jev (TypeSafe System One)
CLASSIFIER=mock
# For CLASSIFIER=jev, set one of these. TYPESAFE_API_KEY pins JEV_MODEL; the gateway serves unversioned jev.
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
JEV_MODEL=jev-1.13.0

# Reasoning model for the unsure subset and drafting: mock (default) or claude
LLM=mock
# For LLM=claude: pip install anthropic, then set a key (or use an `ant auth login` profile)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Optional folder overrides (default: ./data, ./runs, ./runs/.cache)
GLP_DATA_DIR=
GLP_RUNS_DIR=
GLP_CACHE_DIR=
